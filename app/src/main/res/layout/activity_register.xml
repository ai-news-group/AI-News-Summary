<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".RegisterActivity">

    <!-- 给CardView设置最大宽度，解决大屏拉伸问题 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="400dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/tv_register_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/gray_900"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="32dp"/>

            <!-- 用户名输入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/et_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="@color/gray_500"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"/>

                <EditText
                    android:id="@+id/et_register_username"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/username_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:background="@null"
                    android:paddingVertical="16dp"
                    android:textColor="@color/gray_900"
                    android:textColorHint="@color/gray_600"
                    android:autofillHints="username"/>

            </LinearLayout>

            <!-- 密码输入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/et_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="@color/gray_500"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"/>

                <EditText
                    android:id="@+id/et_register_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/password_hint"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:background="@null"
                    android:paddingVertical="16dp"
                    android:textColor="@color/gray_900"
                    android:textColorHint="@color/gray_600"
                    android:autofillHints="password"/>

                <!-- 修复密码切换按钮触摸目标大小和无障碍问题 -->
                <ImageView
                    android:id="@+id/iv_toggle_register_password"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="@color/gray_500"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:contentDescription="显示或隐藏密码"/>

            </LinearLayout>

            <!-- 确认密码输入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/et_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="@color/gray_500"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"/>

                <EditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/confirm_password_hint"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:background="@null"
                    android:paddingVertical="16dp"
                    android:textColor="@color/gray_900"
                    android:textColorHint="@color/gray_600"
                    android:autofillHints="password"/>

                <!-- 修复确认密码切换按钮触摸目标大小和无障碍问题 -->
                <ImageView
                    android:id="@+id/iv_toggle_confirm_password"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="@color/gray_500"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:contentDescription="显示或隐藏确认密码"/>

            </LinearLayout>

            <!-- 注册按钮 -->
            <Button
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/register_button"
                android:background="@drawable/btn_primary"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- 立即登录 - 修复触摸目标大小 -->
            <TextView
                android:id="@+id/tv_login_now"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/have_account"
                android:textColor="@color/primary_start"
                android:textSize="14sp"
                android:layout_gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:contentDescription="立即登录"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
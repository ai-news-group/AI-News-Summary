<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".ForgotPasswordActivity">

    <!-- 给CardView设置最大宽度，解决"too wide"警告 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="400dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/tv_forgot_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/gray_900"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="32dp"/>

            <!-- 邮箱输入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/et_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_dialog_email"
                    app:tint="@color/gray_500"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"/>

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/email_hint"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:background="@null"
                    android:paddingVertical="16dp"
                    android:textColor="@color/gray_900"
                    android:textColorHint="@color/gray_600"
                    android:autofillHints="emailAddress"/>

            </LinearLayout>

            <!-- 验证码输入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/et_rounded"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="@color/gray_500"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null"/>

                    <EditText
                        android:id="@+id/et_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/code_hint"
                        android:inputType="number"
                        android:maxLines="1"
                        android:background="@null"
                        android:paddingVertical="16dp"
                        android:textColor="@color/gray_900"
                        android:textColorHint="@color/gray_600"
                        android:autofillHints="smsCode"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_send_code"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/send_code"
                    android:background="@drawable/btn_code"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"/>

            </LinearLayout>

            <!-- 新密码输入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/et_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="@color/gray_500"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"/>

                <EditText
                    android:id="@+id/et_new_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/new_password_hint"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:background="@null"
                    android:paddingVertical="16dp"
                    android:textColor="@color/gray_900"
                    android:textColorHint="@color/gray_600"
                    android:autofillHints="password"/>

                <!-- 修复密码切换按钮触摸目标大小和无障碍问题 -->
                <ImageView
                    android:id="@+id/iv_toggle_new_password"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="@color/gray_500"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:contentDescription="显示或隐藏密码"/>

            </LinearLayout>

            <!-- 重置密码按钮 -->
            <Button
                android:id="@+id/btn_reset_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/reset_password"
                android:background="@drawable/btn_primary"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/apk/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="AI-News-Summary"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AINewsSummary"
        android:usesCleartextTraffic="true">

        <!-- 根目录的 MainActivity（你的界面）作为启动页 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- develop 分支的 MainActivity（TabLayout 版本） -->
        <activity android:name=".activities.MainActivity" />

        <!-- 其他 Activity -->
        <activity android:name=".NewsDetailActivity" />
        <activity android:name=".SearchActivity" />
        <activity android:name=".SourceListActivity" />
        <activity android:name=".SummarySettingsActivity" />


        <!-- 历史模块 -->

        <activity android:name=".HistoryActivity" />
        <activity android:name=".HistoryDetailActivity" />
        <activity android:name=".HistoryStatsActivity" />
        <activity android:name=".HistoryGroupActivity" />  <!-- ← 添加这一行 -->

    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限（新闻功能必需） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AINewsSummary"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 启动页（登录流程入口） -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 组长的新闻列表主页面（TabLayout版本） -->
        <activity android:name=".activities.MainActivity" android:exported="false"/>

        <!-- 登录相关页面 -->
        <activity android:name=".LoginActivity" android:exported="false"/>
        <activity android:name=".RegisterActivity" android:exported="false"/>
        <activity android:name=".ForgotPasswordActivity" android:exported="false"/>
        <activity android:name=".HomeActivity" android:exported="false"/>

        <!-- 新闻功能页面 -->
        <activity android:name=".NewsDetailActivity" android:exported="false"/>
        <activity android:name=".SearchActivity" android:exported="false"/>
        <activity android:name=".SourceListActivity" android:exported="false"/>
        <activity android:name=".SummarySettingsActivity" android:exported="false"/>

        <!-- 历史模块页面 -->
        <activity android:name=".HistoryActivity" android:exported="false"/>
        <activity android:name=".HistoryDetailActivity" android:exported="false"/>
        <activity android:name=".HistoryStatsActivity" android:exported="false"/>
        <activity android:name=".HistoryGroupActivity" android:exported="false"/>

    </application>

</manifest>